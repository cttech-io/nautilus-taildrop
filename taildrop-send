#!/usr/bin/python3
"""Send files over Taildrop with a progress window.

Usage: taildrop-send <target> <file>...

Each file is streamed into `tailscale file cp -` so progress is exact
bytes written rather than parsed from the CLI's terminal output.
"""
import os
import signal
import subprocess
import sys
import threading
import time

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, GLib, Gtk

TAILSCALE = os.environ.get("TAILDROP_TAILSCALE", "/usr/bin/tailscale")
CHUNK = 256 * 1024


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def notify(summary, body="", icon="document-send"):
    subprocess.run(["notify-send", "-a", "Taildrop", "-i", icon, summary, body])


def target_status(target):
    """'' if online, the CLI's status text if offline, None if unknown."""
    try:
        out = subprocess.run([TAILSCALE, "file", "cp", "--targets"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) >= 2 and parts[1] == target:
            return parts[2] if len(parts) > 2 else ""
    return None


class SendWindow(Adw.ApplicationWindow):
    def __init__(self, app, target, paths):
        super().__init__(application=app, title="Taildrop",
                         default_width=420, resizable=False)
        self.target, self.paths = target, paths
        self.total = sum(os.path.getsize(p) for p in paths)
        self.sent = 0
        self.proc = None
        self.cancelled = False
        self.started = time.monotonic()

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                      margin_top=18, margin_bottom=18, margin_start=18, margin_end=18)
        self.title = Gtk.Label(xalign=0, ellipsize=3, css_classes=["heading"])
        self.bar = Gtk.ProgressBar()
        self.detail = Gtk.Label(xalign=0, css_classes=["dim-label", "caption"])
        self.button = Gtk.Button(label="Cancel", halign=Gtk.Align.END)
        self.button.connect("clicked", self.on_button)
        for w in (self.title, self.bar, self.detail, self.button):
            box.append(w)

        view = Adw.ToolbarView(content=box)
        view.add_top_bar(Adw.HeaderBar(show_title=False))
        self.set_content(view)
        self.connect("close-request", self.on_close)

        threading.Thread(target=self.worker, daemon=True).start()
        GLib.timeout_add(200, self.tick)

    # --- UI (main thread) -------------------------------------------------

    def tick(self):
        if self.proc is None and self.sent == 0:
            return True
        frac = self.sent / self.total if self.total else 1.0
        self.bar.set_fraction(min(frac, 1.0))
        elapsed = max(time.monotonic() - self.started, 0.001)
        rate = self.sent / elapsed
        eta = (self.total - self.sent) / rate if rate > 0 else 0
        self.detail.set_label(
            f"{human(self.sent)} of {human(self.total)} · {human(rate)}/s"
            + (f" · {int(eta // 60)}:{int(eta % 60):02d} left" if eta >= 1 else ""))
        return self.button.get_label() == "Cancel"

    def set_file(self, i, path):
        name = os.path.basename(path)
        prefix = f"({i + 1}/{len(self.paths)}) " if len(self.paths) > 1 else ""
        self.title.set_label(f"{prefix}Sending {name} to {self.target}")

    def finish(self, ok, message):
        self.button.set_label("Close")
        self.title.set_label(message)
        if ok:
            self.bar.set_fraction(1.0)
            notify(message)
            GLib.timeout_add(1500, self.close)
        else:
            self.bar.add_css_class("error")
            notify(message, self.detail.get_label(), "dialog-error")

    def fail(self, message, detail=""):
        if detail:
            self.detail.set_label(detail)
        self.finish(False, message)

    def on_button(self, _btn):
        if self.button.get_label() == "Cancel":
            self.cancel()
        self.close()

    def on_close(self, _win):
        self.cancel()
        return False

    def cancel(self):
        if self.button.get_label() == "Cancel":
            self.cancelled = True
            if self.proc and self.proc.poll() is None:
                self.proc.send_signal(signal.SIGINT)

    # --- transfer (worker thread) -----------------------------------------

    def worker(self):
        status = target_status(self.target)
        if status:
            GLib.idle_add(self.fail, f"{self.target} is offline", status)
            return
        for i, path in enumerate(self.paths):
            GLib.idle_add(self.set_file, i, path)
            err = self.send_one(path)
            if self.cancelled:
                return
            if err is not None:
                GLib.idle_add(self.fail, f"Taildrop to {self.target} failed", err)
                return
        what = os.path.basename(self.paths[0]) if len(self.paths) == 1 else f"{len(self.paths)} files"
        GLib.idle_add(self.finish, True, f"Sent {what} to {self.target}")

    def send_one(self, path):
        """Returns None on success, an error string on failure."""
        self.proc = subprocess.Popen(
            [TAILSCALE, "file", "cp", "--update-interval=0",
             "--name", os.path.basename(path), "-", f"{self.target}:"],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        try:
            with open(path, "rb") as f:
                while chunk := f.read(CHUNK):
                    if self.cancelled:
                        break
                    self.proc.stdin.write(chunk)
                    self.sent += len(chunk)
            self.proc.stdin.close()
        except BrokenPipeError:
            pass  # tailscale exited early; its output says why
        except OSError as e:
            self.proc.kill()
            return str(e)
        out = self.proc.stdout.read().decode(errors="replace").strip()
        if self.proc.wait() == 0:
            return None
        lines = out.splitlines()
        return lines[-1] if lines else f"tailscale exited with status {self.proc.returncode}"


def main():
    if len(sys.argv) < 3:
        sys.exit(__doc__)
    target, paths = sys.argv[1], sys.argv[2:]
    app = Adw.Application(application_id=None)
    app.connect("activate", lambda a: SendWindow(a, target, paths).present())
    app.run([])


if __name__ == "__main__":
    main()
